# Hetzner production — bu dosyayı sunucuda .env.production olarak kopyalayın
# docker-compose ayrıca POSTGRES_* ve DOMAIN kullanır (.env)

DOMAIN=cimcimkids.com
POSTGRES_DB=cimcimkids
POSTGRES_USER=cimcim
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# App (docker-compose DATABASE_URL'i db servisine göre ezer)
NEXTAUTH_URL=https://www.cimcimkids.com
NEXTAUTH_SECRET=CHANGE_ME_RANDOM_64_CHARS
# Required behind Caddy and/or Cloudflare (uses CF-Connecting-IP / X-Forwarded-For)
TRUST_PROXY=true

ADMIN_EMAILS=emrhgtr@gmail.com,info@cimcimkids.com,efruzebendes@hotmail.com,efruzebendes90@gmail.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Search Console verification meta content
# GOOGLE_SITE_VERIFICATION=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CimcimKids <info@cimcimkids.com>
ORDER_NOTIFICATION_EMAIL=info@cimcimkids.com

# Web Push (admin arka plan sipariş bildirimi)
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@cimcimkids.com

NEXT_PUBLIC_IBAN=TR590006701000000208433897
NEXT_PUBLIC_ACCOUNT_HOLDER=Nuriye Kostak
NEXT_PUBLIC_BANK_NAME=Yapı Kredi

# Müşteri kargo ücreti (1500 TL altı). Üstü ücretsiz.
# NEXT_PUBLIC_FREE_SHIPPING_MIN=1500
# NEXT_PUBLIC_SHIPPING_FEE=119

# iyzico kart ödemesi
