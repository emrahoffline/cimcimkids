# PostgreSQL (Neon / Supabase / yerel)
# Neon: https://console.neon.tech → Create project → Connection string (pooled)
# Örnek: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# NextAuth
# Telefondan ngrok ile test ederken burayı ngrok HTTPS URL'si yapın:
# NEXTAUTH_URL=https://xxxx.ngrok-free.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here

# Admin allowlist (virgülle ayırın). Boşsa kod içi varsayılanlar kullanılır.
# ADMIN_EMAILS=emrhgtr@gmail.com,info@cimcimkids.com,efruzebendes@hotmail.com

# Dev-only admin password login. Production'da kapalıdır.
# Production'da açmak için ayrıca ALLOW_ADMIN_PASSWORD_LOGIN=true gerekir (önerilmez).
# ADMIN_DEV_PASSWORD=your-dev-password
# ALLOW_ADMIN_PASSWORD_LOGIN=false

# Reverse proxy arkasında (nginx/cloudflare) true yapın
# TRUST_PROXY=true

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In — https://developer.apple.com/
APPLE_ID=
APPLE_SECRET=

# Mağaza bilgileri (opsiyonel — varsayılanlar kodda tanımlı)
NEXT_PUBLIC_IBAN=TR590006701000000208433897
NEXT_PUBLIC_ACCOUNT_HOLDER=CimcimKids
NEXT_PUBLIC_BANK_NAME=Yapı Kredi

# E-posta bildirimi (sipariş geldiğinde)
# Gmail için: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, uygulama şifresi kullanın
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CimcimKids <info@cimcimkids.com>
ORDER_NOTIFICATION_EMAIL=info@cimcimkids.com
