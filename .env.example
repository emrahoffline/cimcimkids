# PostgreSQL (Neon / Supabase / yerel)
# Neon: https://console.neon.tech → Create project → Connection string (pooled)
# Örnek: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# NextAuth
# Telefondan ngrok ile test ederken burayı ngrok HTTPS URL'si yapın:
# NEXTAUTH_URL=https://xxxx.ngrok-free.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here

# Admin allowlist (virgülle ayırın). Boşsa kod içi varsayılanlar kullanılır.
# ADMIN_EMAILS=emrhgtr@gmail.com,info@cimcimkids.com,efruzebendes@hotmail.com,efruzebendes90@gmail.com

# Dev-only admin password login. Production'da kapalıdır.
# Production'da açmak için ayrıca ALLOW_ADMIN_PASSWORD_LOGIN=true gerekir (önerilmez).
# ADMIN_DEV_PASSWORD=your-dev-password
# ALLOW_ADMIN_PASSWORD_LOGIN=false

# Reverse proxy arkasında (Caddy / Cloudflare) true yapın.
# Cloudflare kullanıyorsanız gerçek ziyaretçi IP'si CF-Connecting-IP'den okunur.
# TRUST_PROXY=true

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In — https://developer.apple.com/
APPLE_ID=
APPLE_SECRET=

# Mağaza bilgileri (opsiyonel — varsayılanlar kodda tanımlı)
NEXT_PUBLIC_IBAN=TR590006701000000208433897
NEXT_PUBLIC_ACCOUNT_HOLDER=Nuriye Kostak
NEXT_PUBLIC_BANK_NAME=Yapı Kredi

# Kargo (müşteriye yansıyan tutar). 1500 TL ve üzeri ücretsiz.
# NEXT_PUBLIC_FREE_SHIPPING_MIN=1500
# NEXT_PUBLIC_SHIPPING_FEE=119

# e-Fatura / e-Arşiv — Bien Teknoloji (Trendyol ile aynı özel entegratör)
# Portal: https://portal.bienteknoloji.com.tr
# Web servis kullanıcısı portal şifresinden ayrıdır (Ayarlar → Kullanıcılar / Web servis).
# BIEN_USERNAME=
# BIEN_PASSWORD=
# BIEN_TEST=false
# EFATURA_AUTO_ISSUE=true
# EFATURA_ARCHIVE_SERIES=CKA
# EFATURA_INVOICE_SERIES=CKF
# EFATURA_PROFILE=TEMELFATURA
# DEFAULT_KDV_RATE=10
# GIFT_CARD_KDV_RATE=20
# COMPANY_TITLE=Nuriye Kostak
# COMPANY_TCKN=
# COMPANY_VKN=
# COMPANY_TAX_OFFICE=Didim
# COMPANY_ADDRESS=Akbük Mah. 5932 Cad. Rüyamkent No: 7/4
# COMPANY_DISTRICT=Didim
# COMPANY_CITY=Aydın
# COMPANY_POSTAL_CODE=
# COMPANY_PHONE=905337007318
# COMPANY_EMAIL=info@cimcimkids.com
# COMPANY_WEBSITE=https://www.cimcimkids.com
# COMPANY_MERSIS=

# Navlungo Domestic (yurt içi kargo karşılaştırma + etiket)
# Panel: https://domestic.navlungo.com
# Adres Defteri’ne gönderici/depo ekleyin; ID’yi NAVLUNGO_SENDER_ADDRESS_ID olarak yazın.
# NAVLUNGO_USERNAME=
# NAVLUNGO_PASSWORD=
# NAVLUNGO_SENDER_ADDRESS_ID=
# NAVLUNGO_TEST=false

# iyzico kart ödemesi (Checkout Form / 3D Secure)
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_URI=https://api.iyzipay.com
# IYZICO_CALLBACK_ORIGIN=https://www.cimcimkids.com

# Google Search Console site verification (meta content değeri)
# GOOGLE_SITE_VERIFICATION=

# Google Merchant Center — Customer Reviews (mağaza değerlendirmesi)
# NEXT_PUBLIC_GOOGLE_MERCHANT_ID=5844059915

# Google Analytics 4 ölçüm kimliği
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XFDECWVB9H

# E-posta bildirimi (sipariş geldiğinde)
# Gmail için: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, uygulama şifresi kullanın
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CimcimKids <info@cimcimkids.com>
ORDER_NOTIFICATION_EMAIL=info@cimcimkids.com

# Web Push — admin arka plan sipariş bildirimi (npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@cimcimkids.com
